# Copy to .env.local for local development, or set these in your host's
# environment settings (Vercel: Project -> Settings -> Environment Variables).
# .env* is gitignored — never commit real values.
#
# Every variable here is OPTIONAL. The site builds and runs correctly with
# none of them set; each feature simply stays switched off.

# ── Site domain ──────────────────────────────────────────────────────────────
# The public origin, with NO trailing slash. Feeds every canonical tag, the
# sitemap, robots.txt, the Open Graph URLs and the LocalBusiness structured
# data — set this and the whole site follows.
#
# Leave it empty and the site falls back to https://luvubeautyacademy.com.
# If you deploy anywhere else and do not set this, every page will declare a
# canonical URL on a domain that is not yours, which can keep the site out of
# Google entirely.
NEXT_PUBLIC_SITE_URL=

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID. Analytics renders nothing when unset, so
# local development is not counted in your reports.
# Find it in GA4: Admin -> Data streams -> your web stream.
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID. If you use GTM, configure GA4 *inside* GTM
# and leave NEXT_PUBLIC_GA_ID empty — setting both records every pageview twice.
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification. Use the "HTML tag" method and paste only
# the content="..." value here.
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Lead capture ─────────────────────────────────────────────────────────────
# Where /api/enquiry forwards contact-form submissions. Without this, enquiries
# are only written to the server log — recoverable, but not somewhere you will
# actually see them. Point it at a Google Apps Script web app writing to a
# Sheet, a Zapier/Make catch hook, or your own inbox relay.
# Server-side only: no NEXT_PUBLIC_ prefix, so it is never exposed to browsers.
LEAD_WEBHOOK_URL=
